    </PropertyGroup>
    <ItemGroup>
      <RayListsDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\RayTraceCS.hlsl" />
      <RayListsDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\RayReflexScreenSolverCS.hlsl" />
      <RayListsDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\RayListArgsCS.hlsl" />
    </ItemGroup>
    <Touch Files="@(RayListsDependent)" Condition="Exists('$(RayListsHeader)') And $([System.IO.File]::GetLastWriteTime('$(RayListsHeader)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('%(RayListsDependent.FullPath)').Ticks)" />
    <PropertyGroup>
      <RayScreenSolverHeader>$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\RayScreenSolver.hlsli</RayScreenSolverHeader>
    </PropertyGroup>
    <ItemGroup>
      <RayScreenSolverDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\RayReflexScreenSolverCS.hlsl" />
      <RayScreenSolverDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightCS.hlsl" />
      <RayScreenSolverDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightRaysCS.hlsl" />
      <RayScreenSolverDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightRaysHwCS.hlsl" />
      <RayScreenSolverDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightFxcCS.hlsl" />
      <RayScreenSolverDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightRaysFxcCS.hlsl" />
    </ItemGroup>
    <Touch Files="@(RayScreenSolverDependent)" Condition="Exists('$(RayScreenSolverHeader)') And $([System.IO.File]::GetLastWriteTime('$(RayScreenSolverHeader)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('%(RayScreenSolverDependent.FullPath)').Ticks)" />
    <!-- The ray tracers (and their ray query twins) include these: a header newer than a shader touches it, so it is built again. -->
    <PropertyGroup>
      <RayQueryTraceHeader>$(MSBuildThisFileDirectory)Engine\Core\Shaders\Common\RayQueryTrace.hlsli</RayQueryTraceHeader>
      <RayFunctionsHeader>$(MSBuildThisFileDirectory)Engine\Core\Shaders\Common\RayFunctions.hlsli</RayFunctionsHeader>
      <RayDefinesHeader>$(MSBuildThisFileDirectory)Engine\Core\Shaders\Common\RayDefines.hlsli</RayDefinesHeader>
    </PropertyGroup>
    <ItemGroup>
      <RayTracerDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\RayTraceCS.hlsl" />
      <RayTracerDependent Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\GIRayTraceCS.hlsl" />
    </ItemGroup>
    <Touch Files="@(RayTracerDependent)" Condition="Exists('$(RayQueryTraceHeader)') And $([System.IO.File]::GetLastWriteTime('$(RayQueryTraceHeader)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('%(RayTracerDependent.FullPath)').Ticks)" />
    <Touch Files="@(RayTracerDependent)" Condition="Exists('$(RayFunctionsHeader)') And $([System.IO.File]::GetLastWriteTime('$(RayFunctionsHeader)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('%(RayTracerDependent.FullPath)').Ticks)" />
    <Touch Files="@(RayTracerDependent)" Condition="Exists('$(RayDefinesHeader)') And $([System.IO.File]::GetLastWriteTime('$(RayDefinesHeader)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('%(RayTracerDependent.FullPath)').Ticks)" />
    <!-- Most of the lighting shaders are one file with a define, or the same file built by the other compiler: each one includes another, so it is
         touched when the one it includes is newer (in this order: the wrappers first, the fxc twins after them). -->
    <ItemGroup>
      <LightWrapper Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightRaysCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightCS.hlsl</Includes></LightWrapper>
      <LightWrapper Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightRaysHwCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightRaysCS.hlsl</Includes></LightWrapper>
      <LightWrapper Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\RayTraceHwCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\RayTraceCS.hlsl</Includes></LightWrapper>
      <LightWrapper Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\GIRayTraceHwCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\RayTrace\GIRayTraceCS.hlsl</Includes></LightWrapper>
      <LightWrapper Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightWaterCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightCS.hlsl</Includes></LightWrapper>
      <LightWrapper Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightLavaCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightCS.hlsl</Includes></LightWrapper>
    </ItemGroup>
    <Touch Files="@(LightWrapper)" Condition="Exists('%(LightWrapper.Includes)') And $([System.IO.File]::GetLastWriteTime('%(LightWrapper.Includes)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('%(LightWrapper.FullPath)').Ticks)" />
    <ItemGroup>
      <LightTwin Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightFxcCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightCS.hlsl</Includes></LightTwin>
      <LightTwin Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightRaysFxcCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightRaysCS.hlsl</Includes></LightTwin>
      <LightTwin Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightWaterFxcCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightWaterCS.hlsl</Includes></LightTwin>
      <LightTwin Include="$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightLavaFxcCS.hlsl"><Includes>$(MSBuildThisFileDirectory)Engine\Core\Shaders\ComputeShaders\DeferredLightLavaCS.hlsl</Includes></LightTwin>
    </ItemGroup>
    <Touch Files="@(LightTwin)" Condition="Exists('%(LightTwin.Includes)') And $([System.IO.File]::GetLastWriteTime('%(LightTwin.Includes)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('%(LightTwin.FullPath)').Ticks)" />
  </Target>
</Project>